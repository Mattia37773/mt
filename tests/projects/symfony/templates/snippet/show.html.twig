{% extends 'base.html.twig' %}

{% block title %}Snippet: {{ snippet.name }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-5xl">

    <div class="mb-6">
        <a href="{{ path('app_snippet_index') }}" class="btn btn-ghost btn-sm gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Zurück zur Liste
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-base-100 p-2 rounded-2xl shadow-sm border border-base-200">
                <div class="p-4">
                    <h1 class="text-3xl font-extrabold tracking-tight text-base-content mb-2">
                        {{ snippet.name }}
                    </h1>
                </div>

                <div class="mockup-code w-full shadow-lg rounded-xl overflow-x-auto bg-neutral text-neutral-content">
                    <pre class="px-5"><code>{{ snippet.code }}</code></pre>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="card bg-base-100 border border-base-200 shadow-sm">
                <div class="card-body gap-4">
                    <h3 class="card-title text-sm uppercase tracking-wider text-base-content/60">Veröffentlicht von</h3>

                    <div class="flex items-center gap-3">
                        <div>
                            <div class="font-bold text-base-content">{{ snippet.author.username }}</div>
                            <div class="text-xs text-base-content/60">Snippet-Creator</div>
                        </div>
                    </div>

                    <div class="divider my-1"></div>
                    <div class="flex flex-wrap gap-2 mt-3">
                        {% for categorie in snippet.categories %}
                            <span class="badge badge-primary badge-outline font-medium px-3 py-3">
                                {{ categorie.name }}
                            </span>
                        {% else %}
                            <span class="text-xs text-base-content/50 italic">Keine Kategorien</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
